{
  "env": {
    "JAVA_HOME": "/Applications/Android Studio.app/Contents/jbr/Contents/Home"
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/compile-check.sh",
            "timeout": 180,
            "statusMessage": "Compiling TeamCode..."
          }
        ]
      }
    ]
  }
}
